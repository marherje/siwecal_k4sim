<detector name="SiPad" type="SiPadDetector" vis="EcalVis" id="1"
          readout="SiPadHits" insideTrackingVolume="false">

  <dimensions x="Ecal_dim_x" y="Ecal_dim_y" z="Ecal_dim_z"/>

  <envelope vis="EcalVis">
    <shape type="Box"
           dx="Ecal_dim_x/2.0 + env_safety"
           dy="Ecal_dim_y/2.0 + env_safety"
           dz="Ecal_dim_z/2.0 + env_safety"
           material="Air"/>
    <rotation x="0" y="0" z="0"/>
    <position x="0" y="0" z="Ecal_z_position"/>
  </envelope>

  <!-- Aluminium box and gap to first layer -->
  <slice material = "Al"          thickness = "Ecal_AlThickness"   vis="AlVis"/>  
  <slice material = "Air"         thickness = "Ecal_Al_frontdistance"   vis="Invisible"/>
  <!-- First layer has asu2026_13, thicker sensor -->
  <layer repeat="1" vis="EcalVis">
  <slice material = "Air"         thickness = "0.001*mm"  vis="AirVis" />
  <slice material = "TungstenDens1910" thickness = "5.60*mm"  vis="TungstenVis" />
  <slice material = "CarbonFiber" thickness = "Ecal_CFThickness"        vis="CFVis"/>
  <slice material = "Cu"          thickness = "Ecal_KaptonThickness"    vis="CuVis" />
  <slice material = "Air"         thickness = "Ecal_GlueThickness_kap"  vis="AirVis"/>
  <slice material = "Si"          thickness = "Ecal_WaferThickness650"     vis="SiVis" sensitive = "yes" />
  <slice material = "Air"         thickness = "Ecal_GlueThickness_pcb"  vis="AirVis"/>
  <slice material = "Cu"          thickness = "Ecal_KaptonThickness"    vis="CuVis" />
  <slice material = "PCB"         thickness = "Ecal_PcbThickness"       vis="PCBVis" />
  <slice material = "Air"         thickness = "Ecal_ChipThickness"       vis="AirVis" />
  <slice material = "Air"         thickness = "Ecal_w_slab_gap650"        vis="AirVis"/>
  </layer>

<!-- 3 similar layers -->
  <layer repeat="3" vis="EcalVis">
    <slice material = "Air"         thickness = "0.001*mm"  vis="AirVis" />
    <slice material="TungstenDens1910" thickness="5.6*mm"   vis="TungstenVis"/>
    <slice material="CarbonFiber"     thickness="Ecal_CFThickness"        vis="CFVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_kap"  vis="AirVis"/>
    <slice material="Silicon"         thickness="Ecal_WaferThickness500"  vis="SiVis" sensitive="yes"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_pcb"  vis="AirVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="PCB"             thickness="Ecal_PcbThickness"       vis="PCBVis"/>
    <slice material="Air"             thickness="Ecal_ChipThickness"      vis="AirVis"/>
    <slice material="Air"             thickness="Ecal_w_slab_gap500"      vis="AirVis"/>
  </layer>

<!-- gap + 1 layer -->

<layer repeat="1" vis="EcalVis">
    <slice material = "Air"         thickness = "Ecal_LayerDistance"  vis="AirVis" />
    <slice material="TungstenDens1910" thickness="5.6*mm"   vis="TungstenVis"/>
    <slice material="CarbonFiber"     thickness="Ecal_CFThickness"        vis="CFVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_kap"  vis="AirVis"/>
    <slice material="Silicon"         thickness="Ecal_WaferThickness500"  vis="SiVis" sensitive="yes"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_pcb"  vis="AirVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="PCB"             thickness="Ecal_PcbThickness"       vis="PCBVis"/>
    <slice material="Air"             thickness="Ecal_ChipThickness"      vis="AirVis"/>
    <slice material="Air"             thickness="Ecal_w_slab_gap500"      vis="AirVis"/>
  </layer>

<!-- 2 more layers with 5.6mm W -->
  <layer repeat="2" vis="EcalVis">
    <slice material = "Air"         thickness = "0.001*mm"  vis="AirVis" />
    <slice material="TungstenDens1910" thickness="5.6*mm"   vis="TungstenVis"/>
    <slice material="CarbonFiber"     thickness="Ecal_CFThickness"        vis="CFVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_kap"  vis="AirVis"/>
    <slice material="Silicon"         thickness="Ecal_WaferThickness500"  vis="SiVis" sensitive="yes"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_pcb"  vis="AirVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="PCB"             thickness="Ecal_PcbThickness"       vis="PCBVis"/>
    <slice material="Air"             thickness="Ecal_ChipThickness"      vis="AirVis"/>
    <slice material="Air"             thickness="Ecal_w_slab_gap500"      vis="AirVis"/>
  </layer>

<!-- 8 layers with 4.2mm W -->
  <layer repeat="8" vis="EcalVis">
    <slice material = "Air"         thickness = "1.4"  vis="AirVis" />
    <slice material="TungstenDens1910" thickness="4.2*mm"   vis="TungstenVis"/>
    <slice material="CarbonFiber"     thickness="Ecal_CFThickness"        vis="CFVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_kap"  vis="AirVis"/>
    <slice material="Silicon"         thickness="Ecal_WaferThickness500"  vis="SiVis" sensitive="yes"/>
    <slice material="Air"             thickness="Ecal_GlueThickness_pcb"  vis="AirVis"/>
    <slice material="Copper"          thickness="Ecal_KaptonThickness"    vis="CuVis"/>
    <slice material="PCB"             thickness="Ecal_PcbThickness"       vis="PCBVis"/>
    <slice material="Air"             thickness="Ecal_ChipThickness"      vis="AirVis"/>
    <slice material="Air"             thickness="Ecal_w_slab_gap500"      vis="AirVis"/>
  </layer>

  <slice material = "Air"         thickness = "Ecal_Al_reardistance"   vis="Invisible"/>
  <slice material = "Al"      thickness = "Ecal_AlThickness"   vis="AlVis"/>

</detector>
