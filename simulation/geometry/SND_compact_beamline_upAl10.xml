<lccdd xmlns:compact="http://www.lcsim.org/schemas/compact/1.0"
       xmlns:xs="http://www.w3.org/2001/XMLSchema"
       xs:noNamespaceSchemaLocation="http://www.lcsim.org/schemas/compact/1.0/compact.xsd">

  <info name="SND_sim_beamline" title="SND simulation with H2/H6-like beamline material in front" author="J.P. Marquez"
        url="" status="development" version="1.0">
    <comment> key4hep 2026-02-01 compatible </comment>
  </info>

  <includes>
    <gdmlFile ref="elements.xml"/>
    <gdmlFile ref="materials.xml"/>
  </includes>

  <define>
    <!-- Detector type flag constants from DD4hep DetType.h -->
    <!-- These are needed by ACTS convertDD4hepDetector to classify subdetectors -->
    <!-- <constant name="DetType_TRACKER"  value="0x1"/> -->
    <!-- <constant name="DetType_BARREL"   value="0x10"/> -->
    <!-- <constant name="DetType_STRIP"    value="0x80"/> -->
    <!-- <constant name="DetType_PIXEL"    value="0x100"/> -->

    <!-- World -->
    <!-- 80 m so the beam can start 30 m upstream and cross that much air (0.1 X0). -->
    <constant name="world_side" value="80*m"/>
    <constant name="world_x"    value="world_side"/>
    <constant name="world_y"    value="world_side"/>
    <constant name="world_z"    value="world_side"/>

    <!-- BEAMLINE MATERIAL in front of the box: the H2 line as it was in June 2026.
         Nothing sat between the end of the vacuum pipe and the box, which stood
         2-3 m downstream of the vacuum window (eyewitness inventory, 2026-09-20).
         What the beam crosses before the box front, the beam being started in
         air just upstream of the window (BEAM_Z_MM = -2650):
           2 XCET Cherenkovs (in the vacuum line), 2 Al windows each   4 x 0.5 mm   0.022 X0
           vacuum exit window, Al                                      1.0 mm       0.011 X0
           air, 2.5 m                                                                0.008 X0
                                                                            total   0.04  X0
         The CMS HGCAL 2018 figure of ~0.5 X0 (JINST 17 P05022) is NOT ours: half
         of it was their own trigger scintillators, veto and delay wire chambers,
         and the rest a longer air path.  That budget is kept for reference in
         SND_compact_beamline_hgcal.xml; the knobs below (residual plate, DWC,
         scintillators) stay at 1 um so a variant is a one-constant edit.
         Measured effect (e- 20/52 GeV, th230): with 0.49 X0 the pre-shower put
         layers 0/1 at sim/data 1.9/1.4; with this line they sit at 0.85-0.94.
         X0: air 303.9 m, Al 88.97 mm, PCB(FR4) ~167 mm, scintillator 424 mm.
         The box's front face sits at z = Ecal_z_position - Ecal_dim_z/2 ~ 0;
         positions are measured from it. -->
    <constant name="Beamline_Front_z"       value="0*mm"/>  <!-- = Ecal_z_position - Ecal_dim_z/2 by construction (defined later in this file) -->
    <constant name="Beamline_XY"            value="300*mm"/>
    <constant name="Beamline_ResidualAl"    value="10*mm"/>  <!-- knob: extra upstream material, none in 2026 -->
    <constant name="Beamline_VacWindowAl"   value="1.0*mm"/>
    <constant name="Beamline_XcetWindowAl"  value="0.5*mm"/>
    <constant name="Beamline_DwcPcb"        value="0.001*mm"/>  <!-- knob: no wire chambers in 2026 -->
    <constant name="Beamline_ScintThick"    value="0.001*mm"/>  <!-- knob: no trigger scintillators in 2026 -->
    <constant name="Beamline_z_Residual"    value="Beamline_Front_z-3000*mm"/>
    <constant name="Beamline_z_VacWindow"   value="Beamline_Front_z-2500*mm"/>
    <constant name="Beamline_z_Xcet1_in"    value="Beamline_Front_z-2580*mm"/>
    <constant name="Beamline_z_Xcet1_out"   value="Beamline_Front_z-2560*mm"/>
    <constant name="Beamline_z_Xcet2_in"    value="Beamline_Front_z-2540*mm"/>
    <constant name="Beamline_z_Xcet2_out"   value="Beamline_Front_z-2520*mm"/>
    <constant name="Beamline_z_Dwc1"        value="Beamline_Front_z-1900*mm"/>
    <constant name="Beamline_z_Scint1"      value="Beamline_Front_z-1750*mm"/>
    <constant name="Beamline_z_Dwc2"        value="Beamline_Front_z-1500*mm"/>
    <constant name="Beamline_z_Scint2"      value="Beamline_Front_z-1300*mm"/>
    <constant name="Beamline_z_Dwc3"        value="Beamline_Front_z-1150*mm"/>
    <constant name="Beamline_z_Scint3"      value="Beamline_Front_z-1000*mm"/>
    <!-- Aluminium box -->
    <constant name="Ecal_AlThickness" value="2*mm"/> 
    <!-- Front distance is from Al plate to layer "-1"-->
    <constant name="Ecal_Al_C_frontdistance" value="29.5*mm"/>
    <!-- Rear distance is from layer "15" to Al plate -->
    <constant name="Ecal_Al_C_reardistance" value="26.0*mm"/>

    <!-- ECAL geometry constants (from ECAL_commondefs.xml) -->
    <constant name="env_safety"              value="0.001*mm"/>
    <constant name="Ecal_NLayers"            value="15"/>

    <!-- Wafer structure of one ASU: 2x2 silicon sensors, each carrying 16x16
         pads. Three length scales, all measured on the real sensor:

           * the active diode        Ecal_PadSizeX    = 5.52 mm
           * the inter-pad margin    Ecal_PadMarginX  = 0.01 mm
           * the pixel pitch         Ecal_CellSizeX   = 5.53 mm  (sum of the two)

         so 16 pixels span Ecal_WaferActiveX = 88.48 mm. The sensor itself is
         larger: it carries an inactive margin Ecal_WaferMarginX = 0.61 mm all
         round (there is no guard ring beyond it), giving a physical sensor of
         Ecal_WaferSizeX = 88.48 + 2*0.61 = 89.70 mm.

         The 0.01 mm inter-pad margin is silicon that belongs to no diode. It is
         0.36% of the area and far below any Geant4 step length, so it is not
         modelled as a volume: the pad array is one sensitive block and the
         segmentation tiles it at the 5.53 mm pitch. The 0.61 mm sensor margin
         *is* modelled, as a non-sensitive silicon frame around the block (see
         the plugin), because it is the only dead region left in a layer. -->
    <constant name="Ecal_PadSizeX"           value="5.52*mm"/>
    <constant name="Ecal_PadSizeY"           value="5.52*mm"/>
    <constant name="Ecal_PadMarginX"         value="0.01*mm"/>
    <constant name="Ecal_PadMarginY"         value="0.01*mm"/>
    <!-- Pixel pitch: what the readout segmentation tiles the sensor with. -->
    <constant name="Ecal_CellSizeX"          value="Ecal_PadSizeX+Ecal_PadMarginX"/>
    <constant name="Ecal_CellSizeY"          value="Ecal_PadSizeY+Ecal_PadMarginY"/>
    <constant name="Ecal_NPadsPerWaferX"     value="16"/>
    <constant name="Ecal_NPadsPerWaferY"     value="16"/>
    <constant name="Ecal_WaferMarginX"       value="0.61*mm"/>
    <constant name="Ecal_WaferMarginY"       value="0.61*mm"/>
    <!-- Sensitive pad array, and the physical sensor that holds it. -->
    <constant name="Ecal_WaferActiveX"       value="Ecal_NPadsPerWaferX*Ecal_CellSizeX"/>
    <constant name="Ecal_WaferActiveY"       value="Ecal_NPadsPerWaferY*Ecal_CellSizeY"/>
    <constant name="Ecal_WaferSizeX"         value="Ecal_WaferActiveX+2*Ecal_WaferMarginX"/>
    <constant name="Ecal_WaferSizeY"         value="Ecal_WaferActiveY+2*Ecal_WaferMarginY"/>
    <constant name="Ecal_NWafersX"           value="2"/>
    <constant name="Ecal_NWafersY"           value="2"/>
    <!-- Extra clearance left between two neighbouring sensors, on top of their
         own margins. The sensors are butted, so this is zero and the dead cross
         between two of them is exactly 2*Ecal_WaferMarginX = 1.22 mm. The wafer
         array then spans 2*89.70 = 179.4 mm, leaving 0.3 mm of border inside the
         180 mm ASU. Raise it if the real modules are mounted with a gap. -->
    <constant name="Ecal_WaferGapX"          value="0*mm"/>
    <constant name="Ecal_WaferGapY"          value="0*mm"/>
    <!-- Number of ASUs tiled per layer. 1x1 = the 18x18 cm test-beam setup;
         2x2 gives a 36x36 cm layer, 3x3 a 54x54 cm one. Changing these two
         constants is all the geometry needs, but the readout block below has one
         entry per wafer and must be regenerated to match:
             python simulation/geometry/make_readout.py <NASUsX> <NASUsY>       -->
    <constant name="Ecal_NASUsX"             value="1"/>
    <constant name="Ecal_NASUsY"             value="1"/>
    <!-- One ASU is 180 mm while its wafers span 179.4 mm, leaving 0.3 mm of
         inactive border per side. Butting ASUs at this pitch therefore creates a
         2*(0.3+0.61) = 1.82 mm dead region between sensors of adjacent ASUs,
         slightly wider than the 1.22 mm cross inside an ASU. Raise the pitch if
         the real modules are mounted with extra clearance. -->
    <constant name="Ecal_ASUPitchX"          value="180*mm"/>
    <constant name="Ecal_ASUPitchY"          value="180*mm"/>
    <constant name="Ecal_NcellsX"            value="Ecal_NASUsX*Ecal_NWafersX*Ecal_NPadsPerWaferX"/>
    <constant name="Ecal_NcellsY"            value="Ecal_NASUsY*Ecal_NWafersY*Ecal_NPadsPerWaferY"/>
    <constant name="Ecal_dim_x"              value="Ecal_NASUsX*Ecal_ASUPitchX"/>
    <constant name="Ecal_dim_y"              value="Ecal_NASUsY*Ecal_ASUPitchY"/>
    <!-- Segmentation offset of the first wafer column/row. The grid is local to
         the sensitive pad array of a wafer (5.53 mm pitch, 16 pads, so the
         offset is measured from Ecal_WaferActiveX and NOT from the physical
         sensor size); the readout block shifts this offset by a whole pad array
         per column/row so that the x/y indices come out as the GLOBAL pad
         indices across the layer (0..31 for one ASU, 0..63 for 2x2, ...). -->
    <constant name="Ecal_SegOffsetX0" value="-(Ecal_WaferActiveX-Ecal_CellSizeX)/2.0"/>
    <constant name="Ecal_SegOffsetY0" value="-(Ecal_WaferActiveY-Ecal_CellSizeY)/2.0"/>

    <constant name="Ecal_CFThickness"        value="1.5*mm"/>
    <constant name="Ecal_KaptonThickness"    value="0.1*mm"/>
    <!-- HV side: of the Ecal_KaptonThickness film, this much is the copper metallisation (the rest is Kapton) -->
    <constant name="Ecal_HVCuThickness"      value="0.02*mm"/>
    <constant name="Ecal_GlueThickness_kap"  value="0.1*mm"/>
    <constant name="Ecal_GlueThickness_pcb"  value="0.1*mm"/>
    <constant name="Ecal_PcbThickness"       value="1.7*mm"/>
    <constant name="Ecal_ChipThickness"      value="1.2*mm"/>
    <constant name="Ecal_LayerDistance"      value="15.0*mm"/>
    <!-- W+post-W-air budget already included as slices in SiPadDetector.xml:
         4.2mm W + 1.4mm air = 5.6mm (slabs 1-8); 5.6mm W + dummyslice ≈ 5.6mm (slabs 9-14).
         Subtracting this from Ecal_LayerDistance restores the correct 11mm slab period. -->
    <constant name="Ecal_W_air_budget"      value="5.6*mm"/>

  <!-- Different thicknesses and gap calculations -->
    <constant name="Ecal_WaferThickness320" value="0.320*mm"/>
    <constant name="Ecal_WaferThickness500" value="0.500*mm"/>
    <constant name="Ecal_WaferThickness650" value="0.650*mm"/>
    <constant name="Ecal_w_slab_gap320"      value="Ecal_LayerDistance-Ecal_W_air_budget-Ecal_CFThickness-Ecal_KaptonThickness-Ecal_GlueThickness_kap-Ecal_WaferThickness320-Ecal_GlueThickness_pcb-Ecal_KaptonThickness-Ecal_PcbThickness-Ecal_ChipThickness"/>
    <constant name="Ecal_w_slab_gap500"      value="Ecal_LayerDistance-Ecal_W_air_budget-Ecal_CFThickness-Ecal_KaptonThickness-Ecal_GlueThickness_kap-Ecal_WaferThickness500-Ecal_GlueThickness_pcb-Ecal_KaptonThickness-Ecal_PcbThickness-Ecal_ChipThickness"/>
    <constant name="Ecal_w_slab_gap650"      value="Ecal_LayerDistance-Ecal_W_air_budget-Ecal_CFThickness-Ecal_KaptonThickness-Ecal_GlueThickness_kap-Ecal_WaferThickness650-Ecal_GlueThickness_pcb-Ecal_KaptonThickness-Ecal_PcbThickness-Ecal_ChipThickness"/>
    <!-- Layer 12, the FEV11 chip-on-board: its own sensor thickness constant so
         switching it (500 -> 650 um) is a one-line edit; the gap follows so the
         layer pitch stays 15 mm.  Must agree with sensor_thickness_um[12] in
         mappings/slab_z_positions.yml (analysis/tests/test_sensor_thickness.py). -->
    <constant name="Ecal_WaferThickness_L12" value="Ecal_WaferThickness500"/>
    <constant name="Ecal_w_slab_gap_L12"     value="Ecal_LayerDistance-Ecal_W_air_budget-Ecal_CFThickness-Ecal_KaptonThickness-Ecal_GlueThickness_kap-Ecal_WaferThickness_L12-Ecal_GlueThickness_pcb-Ecal_KaptonThickness-Ecal_PcbThickness-Ecal_ChipThickness"/>

    <!-- Detector envelope dimensions and position -->
    <!-- Box has 17 rail slots (15 active + 2 empty). Each layer counts as one LayerDistance. The rear distance is added after one extra layer used for supporting only W.-->
    <constant name="Ecal_TB_box_z" value="Ecal_LayerDistance*17+Ecal_Al_C_frontdistance+Ecal_Al_C_reardistance+2*Ecal_AlThickness"/>           
    <constant name="Ecal_dim_z" value="Ecal_TB_box_z+0.1*mm"/>
    <constant name="Ecal_z_position"         value="Ecal_dim_z/2.0"/>


    <!-- Required by DDSim's ParticleHandler for MC-truth links (tracker region cylinder).
         For a calorimeter-only setup, set to the detector envelope dimensions.
         The particle handler is also disabled via SIM.part.userParticleHandler='' in the steering. -->
    <constant name="tracker_region_zmax" value="Ecal_dim_z/2.0"/>
    <constant name="tracker_region_rmax" value="Ecal_dim_x/2.0"/>

  </define>

  <limits>
    <limitset name="cal_limits">
      <limit name="step_length_max" particles="*" value="3.0" unit="mm"/>
    </limitset>
  </limits>

  <display>
    <vis name="Invisible"    alpha="0.0" r="0"   g="0"    b="0"    showDaughters="false" visible="false"/>
    <vis name="EcalVis"      alpha="0.1" r="0.7" g="0.7"  b="0.0"  showDaughters="true"  visible="false"/>
    <vis name="TungstenVis"  alpha="0.5" r="0.5" g="0.35" b="0.55" showDaughters="true"  visible="true"/>
    <vis name="AirVis"       alpha="0.01" r="1.0" g="1.0"  b="1.0"  showDaughters="true"  visible="false"/>
    <vis name="SiVis"        alpha="0.5" r="0.9" g="0.9"  b="0.9"  showDaughters="true"  visible="true"/>
    <vis name="AlVis"        alpha="0.1" r="0.7" g="0.7"  b="0.7"  showDaughters="true"  visible="true"/>
    <vis name="PCBVis"       alpha="0.1" r="0.0" g="0.8"  b="0.0"  showDaughters="true"  visible="true"/>
    <vis name="CFVis"        alpha="0.1" r="0.0" g="0.0"  b="0.0"  showDaughters="true"  visible="false"/>
    <vis name="CuVis"        alpha="0.1" r="1.0" g="0.5"  b="0.0"  showDaughters="true"  visible="false"/>
  </display>

  <readouts>
    <!-- 1x1 ASUs = 2x2 wafers = 32x32 pads. Generated by make_readout.py, do not edit by hand. -->
    <readout name="SiPadHits">
      <segmentation type="MultiSegmentation" key="wafer">
        <segmentation name="wafer0" type="TiledLayerGridXY" key_value="0"
                      grid_size_x="Ecal_CellSizeX" grid_size_y="Ecal_CellSizeY"
                      offset_x="Ecal_SegOffsetX0"
                      offset_y="Ecal_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer1" type="TiledLayerGridXY" key_value="1"
                      grid_size_x="Ecal_CellSizeX" grid_size_y="Ecal_CellSizeY"
                      offset_x="Ecal_SegOffsetX0-1*Ecal_NPadsPerWaferX*Ecal_CellSizeX"
                      offset_y="Ecal_SegOffsetY0"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer2" type="TiledLayerGridXY" key_value="2"
                      grid_size_x="Ecal_CellSizeX" grid_size_y="Ecal_CellSizeY"
                      offset_x="Ecal_SegOffsetX0"
                      offset_y="Ecal_SegOffsetY0-1*Ecal_NPadsPerWaferY*Ecal_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
        <segmentation name="wafer3" type="TiledLayerGridXY" key_value="3"
                      grid_size_x="Ecal_CellSizeX" grid_size_y="Ecal_CellSizeY"
                      offset_x="Ecal_SegOffsetX0-1*Ecal_NPadsPerWaferX*Ecal_CellSizeX"
                      offset_y="Ecal_SegOffsetY0-1*Ecal_NPadsPerWaferY*Ecal_CellSizeY"
                      identifier_x="x" identifier_y="y" identifier_layer="layer"/>
      </segmentation>
      <id>system:8,layer:8,slice:5,x:9,y:9,wafer:2</id>
    </readout>

  </readouts>

  <detectors>
    <include ref="SiPadDetector_beamline.xml"/>
    <!-- Beamline elements, 3 m to 1 m upstream of the box (see the Beamline_* constants). -->
    <detector name="Beamline_Residual" type="DD4hep_BoxSegment" id="100" vis="AlVis">
      <material name="Al"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_ResidualAl/2.0"/>
      <position x="0" y="0" z="Beamline_z_Residual"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_VacWindow" type="DD4hep_BoxSegment" id="101" vis="AlVis">
      <material name="Al"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_VacWindowAl/2.0"/>
      <position x="0" y="0" z="Beamline_z_VacWindow"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Xcet1In" type="DD4hep_BoxSegment" id="102" vis="AlVis">
      <material name="Al"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_XcetWindowAl/2.0"/>
      <position x="0" y="0" z="Beamline_z_Xcet1_in"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Xcet1Out" type="DD4hep_BoxSegment" id="103" vis="AlVis">
      <material name="Al"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_XcetWindowAl/2.0"/>
      <position x="0" y="0" z="Beamline_z_Xcet1_out"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Xcet2In" type="DD4hep_BoxSegment" id="104" vis="AlVis">
      <material name="Al"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_XcetWindowAl/2.0"/>
      <position x="0" y="0" z="Beamline_z_Xcet2_in"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Xcet2Out" type="DD4hep_BoxSegment" id="105" vis="AlVis">
      <material name="Al"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_XcetWindowAl/2.0"/>
      <position x="0" y="0" z="Beamline_z_Xcet2_out"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Dwc1" type="DD4hep_BoxSegment" id="106" vis="AlVis">
      <material name="PCB"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_DwcPcb/2.0"/>
      <position x="0" y="0" z="Beamline_z_Dwc1"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Scint1" type="DD4hep_BoxSegment" id="107" vis="AlVis">
      <material name="Scintillator"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_ScintThick/2.0"/>
      <position x="0" y="0" z="Beamline_z_Scint1"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Dwc2" type="DD4hep_BoxSegment" id="108" vis="AlVis">
      <material name="PCB"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_DwcPcb/2.0"/>
      <position x="0" y="0" z="Beamline_z_Dwc2"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Scint2" type="DD4hep_BoxSegment" id="109" vis="AlVis">
      <material name="Scintillator"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_ScintThick/2.0"/>
      <position x="0" y="0" z="Beamline_z_Scint2"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Dwc3" type="DD4hep_BoxSegment" id="110" vis="AlVis">
      <material name="PCB"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_DwcPcb/2.0"/>
      <position x="0" y="0" z="Beamline_z_Dwc3"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
    <detector name="Beamline_Scint3" type="DD4hep_BoxSegment" id="111" vis="AlVis">
      <material name="Scintillator"/>
      <box x="Beamline_XY/2.0" y="Beamline_XY/2.0" z="Beamline_ScintThick/2.0"/>
      <position x="0" y="0" z="Beamline_z_Scint3"/>
      <rotation x="0" y="0" z="0"/>
    </detector>
  </detectors>


</lccdd>
