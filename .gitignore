# Build artifacts
build/
install/
__pycache__/
*.pyc
*.pyo

# Tool caches. Note that listing a pattern here does NOT untrack files already
# committed: the 39 .pyc under __pycache__/ matched the rules above for a long
# time and stayed in the repo regardless, until they were removed from the index.
# Check with: git ls-files -i -c --exclude-standard
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# ROOT files (large binary data — use EOS or CERNBox instead)
*.root

# Compiled shared libraries
*.so
*.so.*
*.a
*.dylib

# Python virtual environments
.venv*/

# Simulation output data
simulation/run_script/data/
simulation/run_script/log/
simulation/run_script/steer/*.mac
simulation/run_script/steer

# Tests
simulation/geometry/general_tests

# Editor / OS
.DS_Store
*.swp
*~
